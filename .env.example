# Optional: only needed if you want the chatbot to use OpenAI instead of the
# built-in rule-based engine. The app works fully WITHOUT this key.
OPENAI_API_KEY=

# Optional: only needed if you want real geocoding instead of the built-in
# demo city dataset (Delhi, Amritsar, Chandigarh, Jalandhar, Ludhiana, Hoshiarpur).
# The app works fully WITHOUT this key.
GEOCODING_API_KEY=
